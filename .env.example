# KnightGPT Environment Configuration
# Copy to .env and customize

# vLLM Embedding Server
# Defaults below match NRP's hosted endpoint (https://ellm.nrp-nautilus.io/v1),
# the current real deployment target -- see docker/docker-compose.yaml's api
# service and k8s/nrp/README.md. Do NOT swap VLLM_EMBEDDING_MODEL back to a
# self-hosted model without also re-discovering and updating
# VLLM_EMBEDDING_DIM below; they must stay consistent or DuckDBStore's
# dimension guard raises at construction.
VLLM_EMBEDDING_URL=http://localhost:8001/v1
VLLM_EMBEDDING_MODEL=qwen3-embedding
VLLM_EMBEDDING_BATCH_SIZE=32
# NRP's hosted qwen3-embedding model's real output dimension, confirmed via a
# live embeddings.create() call against https://ellm.nrp-nautilus.io/v1 on
# 2026-09-14 (see k8s/nrp/README.md "Embedding dimension discovery"). Do not
# assume this value for a different embedding model -- re-discover it with
# the same live-call script if the model changes.
VLLM_EMBEDDING_DIM=4096

# vLLM Inference Server
VLLM_INFERENCE_URL=http://localhost:8000/v1
VLLM_INFERENCE_MODEL=qwen3
VLLM_MAX_TOKENS=4096
VLLM_TEMPERATURE=0.7

# API key for NRP's hosted OpenAI-compatible endpoint (both
# VLLM_EMBEDDING_URL and VLLM_INFERENCE_URL above). Get one at
# https://ellm.nrp-nautilus.io/llmtoken (SDSC/Internet2 affiliates get
# higher fair-use limits). Required -- docker/docker-compose.yaml's api
# service has no default and fails fast at container startup if this is
# unset.
VLLM_API_KEY=

# Postgres (pgGraph) — replaces the old file/Neo4j-backed storage.
# Vector search is handled separately by embedded DuckDB -- see
# INGEST_DUCKDB_PATH below, not a Postgres extension.
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/knightgpt
# Must match the password in POSTGRES_DSN above. Used by
# docker/docker-compose.yaml's postgres service itself.
POSTGRES_PASSWORD=password
# Absolute path, on the deploy host's own filesystem, to the pg_dump file
# postgres's init script restores from on first boot. See
# k8s/nrp/README.md for how to fetch the current dump (rclone from the
# nrp-s3 backup location) before first `docker compose up`.
POSTGRES_BACKUP_DUMP_PATH=/path/to/knightgpt-postgres-<timestamp>.dump

# Knowledge Graph
GRAPH_SIMILARITY_THRESHOLD=0.7
GRAPH_MAX_NEIGHBORS=10
GRAPH_PATH=data/processed/graph.graphml

# Chunking
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Data Directories
INGEST_RAW_PDF_DIR=data/raw_pdfs
INGEST_MARKDOWN_DIR=data/markdown
INGEST_PROCESSED_DIR=data/processed
INGEST_DUCKDB_PATH=data/processed/embeddings.duckdb

# RSS Feed Ingestion
RSS_ENABLED=true
RSS_CHECK_INTERVAL_HOURS=168
RSS_MAX_PAPERS_PER_RUN=50
RSS_FILTER_KEYWORDS=true
# RSS_KL_TOOLS_API_URL=http://localhost:3000

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Open WebUI + Cloudflare Tunnel -- only used by the self-contained
# deployment path (docker/docker-compose.yaml's bundled open-webui/
# cloudflared services). A deploy target that already runs its own shared
# Open WebUI and reverse proxy (e.g. kl-remote -- see
# k8s/nrp/README.md's "kl-remote deployment specifics") doesn't need
# either of these; those services aren't started there at all.
WEBUI_SECRET_KEY=your_secret_key_here
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Hugging Face (for gated models)
# HF_TOKEN=your_hf_token_here
